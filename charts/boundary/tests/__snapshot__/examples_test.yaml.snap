        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: access-logs-https
      namespace: ingress-gateway
    spec:
      accessLogging:
        - providers:
