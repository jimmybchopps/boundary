permissive:
  1: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: deny-egress-via-default
      namespace: egress-gateway
    spec:
      action: ALLOW
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  2: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: Gateway
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default
        gateway.istio.io/service-account: default-waypoint
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
        istio.io/waypoint-for: service
      name: default
      namespace: egress-gateway
    spec:
      gatewayClassName: istio-waypoint
      infrastructure:
        labels:
          app.kubernetes.io/component: egress-waypoint
          app.kubernetes.io/name: default
        parametersRef:
          group: ""
          kind: ConfigMap
          name: default-infrastructure
      listeners:
        - allowedRoutes:
            namespaces:
              from: All
          name: mesh
          port: 15008
          protocol: HBONE
  3: |
    apiVersion: v1
    data:
      deployment: |
        spec:
          replicas: 2
          template:
            spec:
              automountServiceAccountToken: false
              containers:
              - livenessProbe:
                  failureThreshold: 8
                  httpGet:
                    path: /healthz/ready
                    port: 15021
                    scheme: HTTP
                  periodSeconds: 15
                  timeoutSeconds: 3
                name: istio-proxy
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
              topologySpreadConstraints:
              - labelSelector:
                  matchLabels:
                    gateway.networking.k8s.io/gateway-name: default
                maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
      podDisruptionBudget: |
        spec:
          minAvailable: 1
    kind: ConfigMap
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.infrastructure
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: default-infrastructure
      namespace: egress-gateway
  4: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: Gateway
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https
        networking.istio.io/service-type: LoadBalancer
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: https
      namespace: ingress-gateway
    spec:
      gatewayClassName: istio
      infrastructure:
        labels:
          app.kubernetes.io/component: ingress-gateway
          app.kubernetes.io/name: https
        parametersRef:
          group: ""
          kind: ConfigMap
          name: https-infrastructure
      listeners:
        - allowedRoutes:
            namespaces:
              from: Same
          hostname: '*.apps.example.mil'
          name: http
          port: 80
          protocol: HTTP
        - allowedRoutes:
            namespaces:
              from: Selector
              selector:
                matchLabels:
                  ingress.boundary.posture.dev/https: "true"
          hostname: '*.apps.example.mil'
          name: https
          port: 443
          protocol: HTTPS
          tls:
            certificateRefs:
              - group: ""
                kind: Secret
                name: apps-tls
            mode: Terminate
  5: |
    apiVersion: v1
    data:
      deployment: |
        spec:
          replicas: 2
          template:
            spec:
              automountServiceAccountToken: false
              containers:
              - livenessProbe:
                  failureThreshold: 8
                  httpGet:
                    path: /healthz/ready
                    port: 15021
                    scheme: HTTP
                  periodSeconds: 15
                  timeoutSeconds: 3
                name: istio-proxy
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
              topologySpreadConstraints:
              - labelSelector:
                  matchLabels:
                    gateway.networking.k8s.io/gateway-name: https
                maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
      podDisruptionBudget: |
        spec:
          minAvailable: 1
    kind: ConfigMap
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https.infrastructure
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: https-infrastructure
      namespace: ingress-gateway
  6: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https.listeners.http.redirectToHTTPS
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: redirect-http-to-https-https
      namespace: ingress-gateway
    spec:
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: https
          sectionName: http
      rules:
        - filters:
            - requestRedirect:
                scheme: https
                statusCode: 301
              type: RequestRedirect
  7: |
    apiVersion: networking.istio.io/v1alpha3
    kind: EnvoyFilter
    metadata:
      annotations:
        boundary.posture.dev/rule: tls
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: tls-https
      namespace: ingress-gateway
    spec:
      configPatches:
        - applyTo: FILTER_CHAIN
          match:
            context: GATEWAY
            listener:
              portNumber: 443
          patch:
            operation: MERGE
            value:
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                  '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                  common_tls_context:
                    tls_params:
                      tls_maximum_protocol_version: TLSv1_3
                      tls_minimum_protocol_version: TLSv1_2
      workloadSelector:
        labels:
          gateway.networking.k8s.io/gateway-name: https
  8: |
    apiVersion: security.istio.io/v1
    kind: PeerAuthentication
    metadata:
      annotations:
        boundary.posture.dev/rule: mtls.mode
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: mtls-permissive
      namespace: istio-system
    spec:
      mtls:
        mode: PERMISSIVE
  9: |
    apiVersion: telemetry.istio.io/v1
    kind: Telemetry
    metadata:
