                hosts:
                  - '*.ubuntu.com'
                ports:
                  - "80"
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  4: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts.package-mirror
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: allow-egress-via-default-to-package-mirror
      namespace: egress-gateway
    spec:
      action: ALLOW
      rules:
        - to:
            - operation:
                ports:
                  - "443"
          when:
            - key: destination.ip
              values:
                - 203.0.113.10/32
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  5: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.partner.allowedHosts
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: deny-egress-via-partner
      namespace: egress-gateway
    spec:
      action: ALLOW
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: partner
  6: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.partner.allowedHosts.partner-api
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: allow-egress-via-partner-to-partner-api
      namespace: egress-gateway
    spec:
      action: ALLOW
      rules:
        - to:
            - operation:
