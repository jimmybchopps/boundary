deny-all:
  1: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: meshDefaultDeny
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: deny-all
      namespace: istio-system
    spec: {}
  2: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: deny-egress-via-default
      namespace: egress-gateway
    spec:
      action: ALLOW
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  3: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: Gateway
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default
        gateway.istio.io/service-account: default-waypoint
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
        istio.io/waypoint-for: service
      name: default
      namespace: egress-gateway
    spec:
      gatewayClassName: istio-waypoint
      infrastructure:
        labels:
          app.kubernetes.io/component: egress-waypoint
          app.kubernetes.io/name: default
        parametersRef:
          group: ""
          kind: ConfigMap
          name: default-infrastructure
      listeners:
        - allowedRoutes:
            namespaces:
              from: All
          name: mesh
          port: 15008
          protocol: HBONE
  4: |
    apiVersion: v1
    data:
      deployment: |
        spec:
          replicas: 2
          template:
            spec:
              automountServiceAccountToken: false
              containers:
              - livenessProbe:
                  failureThreshold: 8
                  httpGet:
                    path: /healthz/ready
                    port: 15021
                    scheme: HTTP
                  periodSeconds: 15
                  timeoutSeconds: 3
                name: istio-proxy
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
              topologySpreadConstraints:
              - labelSelector:
                  matchLabels:
                    gateway.networking.k8s.io/gateway-name: default
                maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
      podDisruptionBudget: |
        spec:
          minAvailable: 1
    kind: ConfigMap
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.infrastructure
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: default-infrastructure
      namespace: egress-gateway
  5: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: Gateway
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https
        networking.istio.io/service-type: LoadBalancer
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: https
      namespace: ingress-gateway
    spec:
      gatewayClassName: istio
      infrastructure:
        labels:
          app.kubernetes.io/component: ingress-gateway
          app.kubernetes.io/name: https
        parametersRef:
          group: ""
          kind: ConfigMap
          name: https-infrastructure
      listeners:
        - allowedRoutes:
            namespaces:
              from: Same
          hostname: '*.apps.example.mil'
          name: http
          port: 80
          protocol: HTTP
        - allowedRoutes:
            namespaces:
              from: Selector
              selector:
                matchLabels:
                  ingress.boundary.posture.dev/https: "true"
          hostname: '*.apps.example.mil'
          name: https
          port: 443
          protocol: HTTPS
          tls:
            certificateRefs:
              - group: ""
                kind: Secret
                name: apps-tls
            mode: Terminate
  6: |
    apiVersion: v1
    data:
      deployment: |
        spec:
          replicas: 2
          template:
            spec:
              automountServiceAccountToken: false
              containers:
              - livenessProbe:
                  failureThreshold: 8
                  httpGet:
                    path: /healthz/ready
                    port: 15021
                    scheme: HTTP
                  periodSeconds: 15
                  timeoutSeconds: 3
                name: istio-proxy
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
              topologySpreadConstraints:
              - labelSelector:
                  matchLabels:
                    gateway.networking.k8s.io/gateway-name: https
                maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
      podDisruptionBudget: |
        spec:
          minAvailable: 1
    kind: ConfigMap
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https.infrastructure
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: https-infrastructure
      namespace: ingress-gateway
  7: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https.listeners.http.redirectToHTTPS
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: redirect-http-to-https-https
      namespace: ingress-gateway
    spec:
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: https
          sectionName: http
      rules:
        - filters:
            - requestRedirect:
                scheme: https
                statusCode: 301
              type: RequestRedirect
  8: |
    apiVersion: networking.istio.io/v1alpha3
    kind: EnvoyFilter
    metadata:
      annotations:
        boundary.posture.dev/rule: tls
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: tls-https
      namespace: ingress-gateway
    spec:
      configPatches:
        - applyTo: FILTER_CHAIN
          match:
            context: GATEWAY
            listener:
              portNumber: 443
          patch:
            operation: MERGE
            value:
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                  '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                  common_tls_context:
                    tls_params:
                      tls_maximum_protocol_version: TLSv1_3
                      tls_minimum_protocol_version: TLSv1_2
      workloadSelector:
        labels:
          gateway.networking.k8s.io/gateway-name: https
  9: |
    apiVersion: security.istio.io/v1
    kind: PeerAuthentication
    metadata:
      annotations:
        boundary.posture.dev/rule: mtls.mode
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: mtls-strict
      namespace: istio-system
    spec:
      mtls:
        mode: STRICT
  10: |
    apiVersion: telemetry.istio.io/v1
    kind: Telemetry
    metadata:
      annotations:
        boundary.posture.dev/rule: accessLogs
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: access-logs-https
      namespace: ingress-gateway
    spec:
      accessLogging:
        - providers:
            - name: envoy
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: https
  11: |
    apiVersion: telemetry.istio.io/v1
    kind: Telemetry
    metadata:
      annotations:
        boundary.posture.dev/rule: accessLogs
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: access-logs-default
      namespace: egress-gateway
    spec:
      accessLogging:
        - providers:
            - name: envoy
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
egress:
  1: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: deny-egress-via-default
      namespace: egress-gateway
    spec:
      action: ALLOW
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  2: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts.container-registries
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: allow-egress-via-default-to-container-registries
      namespace: egress-gateway
    spec:
      action: ALLOW
      rules:
        - to:
            - operation:
                ports:
                  - "443"
          when:
            - key: connection.sni
              values:
                - '*.docker.io'
                - '*.quay.io'
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  3: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts.github
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: allow-egress-via-default-to-github
      namespace: egress-gateway
    spec:
      action: ALLOW
      rules:
        - to:
            - operation:
                ports:
                  - "443"
          when:
            - key: connection.sni
              values:
                - api.github.com
                - github.com
                - objects.githubusercontent.com
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  4: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts.os-updates
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: allow-egress-via-default-to-os-updates
      namespace: egress-gateway
    spec:
      action: ALLOW
      rules:
        - to:
            - operation:
                hosts:
                  - archive.ubuntu.com
                  - security.ubuntu.com
                ports:
                  - "80"
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  5: |
    apiVersion: security.istio.io/v1
    kind: AuthorizationPolicy
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.allowedHosts.package-mirror
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: allow-egress-via-default-to-package-mirror
      namespace: egress-gateway
    spec:
      action: ALLOW
      rules:
        - to:
            - operation:
                ports:
                  - "443"
                  - "8443"
          when:
            - key: destination.ip
              values:
                - 203.0.113.10/32
                - 203.0.113.11/32
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
  6: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: Gateway
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default
        gateway.istio.io/service-account: default-waypoint
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
        istio.io/waypoint-for: service
      name: default
      namespace: egress-gateway
    spec:
      gatewayClassName: istio-waypoint
      infrastructure:
        labels:
          app.kubernetes.io/component: egress-waypoint
          app.kubernetes.io/name: default
        parametersRef:
          group: ""
          kind: ConfigMap
          name: default-infrastructure
      listeners:
        - allowedRoutes:
            namespaces:
              from: All
          name: mesh
          port: 15008
          protocol: HBONE
  7: |
    apiVersion: v1
    data:
      deployment: |
        spec:
          replicas: 3
          template:
            spec:
              automountServiceAccountToken: false
              containers:
              - livenessProbe:
                  failureThreshold: 8
                  httpGet:
                    path: /healthz/ready
                    port: 15021
                    scheme: HTTP
                  periodSeconds: 15
                  timeoutSeconds: 3
                name: istio-proxy
              nodeSelector:
                node-role.example.mil/egress: "true"
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
              tolerations:
              - effect: NoSchedule
                key: node-role.example.mil/egress
                operator: Exists
              topologySpreadConstraints:
              - labelSelector:
                  matchLabels:
                    gateway.networking.k8s.io/gateway-name: default
                maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
      podDisruptionBudget: |
        spec:
          minAvailable: 2
    kind: ConfigMap
    metadata:
      annotations:
        boundary.posture.dev/rule: egress.gateways.default.infrastructure
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: default-infrastructure
      namespace: egress-gateway
  8: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: Gateway
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https
        networking.istio.io/service-type: LoadBalancer
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: https
      namespace: ingress-gateway
    spec:
      gatewayClassName: istio
      infrastructure:
        labels:
          app.kubernetes.io/component: ingress-gateway
          app.kubernetes.io/name: https
        parametersRef:
          group: ""
          kind: ConfigMap
          name: https-infrastructure
      listeners:
        - allowedRoutes:
            namespaces:
              from: Same
          name: http
          port: 80
          protocol: HTTP
        - allowedRoutes:
            namespaces:
              from: Selector
              selector:
                matchLabels:
                  ingress.boundary.posture.dev/https: "true"
          name: https
          port: 443
          protocol: HTTPS
          tls:
            certificateRefs:
              - group: ""
                kind: Secret
                name: apps-tls
            mode: Terminate
  9: |
    apiVersion: v1
    data:
      deployment: |
        spec:
          replicas: 2
          template:
            spec:
              automountServiceAccountToken: false
              containers:
              - livenessProbe:
                  failureThreshold: 8
                  httpGet:
                    path: /healthz/ready
                    port: 15021
                    scheme: HTTP
                  periodSeconds: 15
                  timeoutSeconds: 3
                name: istio-proxy
              securityContext:
                seccompProfile:
                  type: RuntimeDefault
              topologySpreadConstraints:
              - labelSelector:
                  matchLabels:
                    gateway.networking.k8s.io/gateway-name: https
                maxSkew: 1
                topologyKey: kubernetes.io/hostname
                whenUnsatisfiable: ScheduleAnyway
      podDisruptionBudget: |
        spec:
          minAvailable: 1
    kind: ConfigMap
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https.infrastructure
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: https-infrastructure
      namespace: ingress-gateway
  10: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      annotations:
        boundary.posture.dev/rule: ingress.gateways.https.listeners.http.redirectToHTTPS
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: redirect-http-to-https-https
      namespace: ingress-gateway
    spec:
      parentRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: https
          sectionName: http
      rules:
        - filters:
            - requestRedirect:
                scheme: https
                statusCode: 301
              type: RequestRedirect
  11: |
    apiVersion: networking.istio.io/v1alpha3
    kind: EnvoyFilter
    metadata:
      annotations:
        boundary.posture.dev/rule: tls
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: tls-https
      namespace: ingress-gateway
    spec:
      configPatches:
        - applyTo: FILTER_CHAIN
          match:
            context: GATEWAY
            listener:
              portNumber: 443
          patch:
            operation: MERGE
            value:
              transport_socket:
                name: envoy.transport_sockets.tls
                typed_config:
                  '@type': type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext
                  common_tls_context:
                    tls_params:
                      tls_maximum_protocol_version: TLSv1_3
                      tls_minimum_protocol_version: TLSv1_2
      workloadSelector:
        labels:
          gateway.networking.k8s.io/gateway-name: https
  12: |
    apiVersion: security.istio.io/v1
    kind: PeerAuthentication
    metadata:
      annotations:
        boundary.posture.dev/rule: mtls.mode
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: mtls-strict
      namespace: istio-system
    spec:
      mtls:
        mode: STRICT
  13: |
    apiVersion: telemetry.istio.io/v1
    kind: Telemetry
    metadata:
      annotations:
        boundary.posture.dev/rule: accessLogs
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: access-logs-https
      namespace: ingress-gateway
    spec:
      accessLogging:
        - providers:
            - name: envoy
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: https
  14: |
    apiVersion: telemetry.istio.io/v1
    kind: Telemetry
    metadata:
      annotations:
        boundary.posture.dev/rule: accessLogs
      labels:
        app.kubernetes.io/instance: boundary
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boundary
        helm.sh/chart: boundary-0.1.1
      name: access-logs-default
      namespace: egress-gateway
    spec:
      accessLogging:
        - providers:
            - name: envoy
      targetRefs:
        - group: gateway.networking.k8s.io
          kind: Gateway
          name: default
full:
  1: |
